##@ Mocking

MOCKERY_VERSION?=v3.8.0
MOCKERY_BIN=${UTILITY_BIN_PATH}/mockery
MOCKERY_YAML=${WORKDIR}/.mockery.yaml
MOCKERY_YAML_TEMPLATE=${BUILD_DIR}/make/mockery.yaml.tpl

# The file name contains the version without the leading 'v', the URL path contains it with.
MOCKERY_VERSION_NUM=$(patsubst v%,%,${MOCKERY_VERSION})
MOCKERY_URL?=https://github.com/vektra/mockery/releases/download/${MOCKERY_VERSION}/mockery_${MOCKERY_VERSION_NUM}_Linux_x86_64.tar.gz
MOCKERY_SUM?=ba8697cf5cf7164756afca371c247088980e4be7ded133e50536d8ae5c893a9a
MOCKERY_ARCHIVE_PATH?=mockery
MOCKERY_ARCHIVE_STRIP?=0

# curl-get-tool-from-tar only downloads if the binary is missing. Without this check a bump of
# MOCKERY_VERSION would silently keep using the old binary.
.PHONY: mockery-version-check
mockery-version-check:
	@[ ! -x ${MOCKERY_BIN} ] \
		|| [ "$$(${MOCKERY_BIN} version 2>/dev/null)" = "${MOCKERY_VERSION}" ] \
		|| { echo "Removing outdated mockery $$(${MOCKERY_BIN} version 2>/dev/null)" ; rm -f ${MOCKERY_BIN} ; }

${MOCKERY_BIN}: mockery-version-check ${UTILITY_BIN_PATH}
	$(call curl-get-tool-from-tar,$(MOCKERY_BIN),$(MOCKERY_URL),$(MOCKERY_SUM),$(MOCKERY_ARCHIVE_PATH),$(MOCKERY_ARCHIVE_STRIP))

.PHONY: mocks
mocks: ${MOCKERY_BIN} ## Generates the mocks configured in .mockery.yaml
	@if [ ! -f ${MOCKERY_YAML} ]; then \
		echo "ERROR: ${MOCKERY_YAML} not found." ;\
		echo "  New repository:    run 'make mocks-init'" ;\
		exit 1 ;\
	fi
	@cd ${WORKDIR} && ${MOCKERY_BIN}
	@echo "Mocks successfully created."

.PHONY: mocks-init
mocks-init: ## Creates a .mockery.yaml with sensible defaults
	@if [ -f ${MOCKERY_YAML} ]; then \
		echo "ERROR: ${MOCKERY_YAML} already exists. Remove it first if you want to recreate it." ;\
		exit 1 ;\
	fi
	@if [ ! -f ${WORKDIR}/go.mod ] && [ ! -f ${WORKDIR}/go.work ]; then \
		echo "ERROR: Neither go.mod nor go.work found in ${WORKDIR}." ;\
		exit 1 ;\
	fi
	@MODULES=$$(cd ${WORKDIR} && go list -m) || exit 1 ;\
	MODULES="$$MODULES" awk ' \
		BEGIN { n = split(ENVIRON["MODULES"], modules, "\n") } \
		/^@PACKAGES@$$/ { for (i = 1; i <= n; i++) printf "  %s:\n    config: {}\n", modules[i] ; next } \
		{ print }' \
		${MOCKERY_YAML_TEMPLATE} > ${MOCKERY_YAML}
	@echo "Created ${MOCKERY_YAML}."

.PHONY: mocks-delete
mocks-delete: ## Deletes all files generated by mockery
	@{ grep -rl --include='*.go' \
		--exclude-dir=vendor --exclude-dir=.git --exclude-dir=.bin \
		'Code generated by mockery' ${WORKDIR} || true ; } \
		| xargs -r rm -v
	@echo "Generated mocks deleted."
