root.controller.steps.install.WarpMenuEntryStep : new struct
root.controller.steps.install.interfaces :  create warpMenuEntryManager interface

root.controller.usecase.usecase : include warpMenuEntryStep

root.controller.warpmenuentry.interface : interface
root.controller.warpmenuentry.manager : main logic implementation

}

