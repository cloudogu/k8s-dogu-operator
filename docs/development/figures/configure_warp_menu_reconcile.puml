title Warp Menu Functionality Configuration

rectangle "Dogu operator" as backend <<$cloudogu>> #white {
root.main : configure manager, step, client-set/interfaces
root.controller.dogu_controller : add owns_WarpMenuEntry



root.controller.initfx.controlManager  : add warpMenuEntryV1.AddToScheme
root.controller.initfx.interfaces : create interfaces for warpmenuentryClient , warpmenuentryInterface
